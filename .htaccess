# RMC Events - root protection
# Blocks direct browser access to configuration/credential files and
# internal notes. PHP's own include()/require() is NOT affected by this -
# only direct HTTP requests to these files are blocked.

<FilesMatch "^(config\.local\.php|config\.local\.php\.example|email_config\.local\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|sql|bak)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(UPDATE_NOTES\.txt|DEPLOYMENT_CONFIG\.txt)$">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes
